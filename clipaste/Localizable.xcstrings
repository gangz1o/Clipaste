    "These shortcuts are handled only when the Clipaste panel is the active window, so native shortcuts in Notes, browsers, Terminal, and other apps stay intact." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Kurzbefehle werden nur verarbeitet, wenn das Clipaste-Panel das aktive Fenster ist. Native Kurzbefehle in Notizen, Browsern, Terminal und anderen Apps bleiben unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These shortcuts are handled only when the Clipaste panel is the active window, so native shortcuts in Notes, browsers, Terminal, and other apps stay intact."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces raccourcis ne sont gérés que lorsque le panneau Clipaste est la fenêtre active, afin de préserver les raccourcis natifs dans Notes, les navigateurs, Terminal et les autres apps."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのショートカットは、Clipaste パネルがアクティブウィンドウのときにのみ処理されるため、メモ、ブラウザ、Terminal など他のアプリの標準ショートカットには影響しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 단축키는 Clipaste 패널이 활성 창일 때만 처리되므로, 메모, 브라우저, 터미널 및 기타 앱의 기본 단축키는 그대로 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些快捷键只会在 Clipaste 面板处于活动窗口时处理，因此备忘录、浏览器、终端等应用里的原生快捷键不会受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些快捷鍵只會在 Clipaste 面板處於作用中視窗時處理，因此備忘錄、瀏覽器、終端機等 App 內的原生快捷鍵不會受影響。"
          }
        }
      }
    },
