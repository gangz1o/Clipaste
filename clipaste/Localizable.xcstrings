    "Model Supports Image Input Footer" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren, wenn das gewählte Modell Bildeingaben akzeptiert. KI-OCR entscheidet anhand dieses Schalters, ob das Modell zur Bilderkennung aufgerufen werden kann."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enable this when the chosen model accepts image input. AI OCR uses this flag to decide whether the model can be called for image recognition."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez cette option si le modèle choisi accepte les images. L’OCR IA s’appuie sur ce drapeau pour décider d’utiliser ou non le modèle pour la reconnaissance d’image."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したモデルが画像入力に対応している場合に有効にしてください。AI OCR はこの設定で画像認識にモデルを使えるかどうかを判定します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 모델이 이미지 입력을 지원하는 경우 켜세요. AI OCR은 이 값을 기준으로 모델을 이미지 인식에 사용할 수 있는지 판단합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当所选模型支持图片输入时勾选此项。AI OCR 会据此判断是否可以调用该模型进行图片识别。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
