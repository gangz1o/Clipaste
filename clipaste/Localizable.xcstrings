    "Permanently deletes all clipboard records and image caches. This cannot be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht dauerhaft alle Zwischenablagen-Einträge und Bildcaches. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement les entrées du presse-papiers qui ne sont pas dans les favoris ainsi que le cache images. Les éléments figurant dans les favoris sont conservés. "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのクリップボード記録と画像キャッシュを完全に削除します。この操作は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 클립보드 기록과 이미지 캐시를 영구적으로 삭제합니다. 취소할 수 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除所有剪贴板记录和图片缓存，此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將永久刪除所有剪貼板記錄及相關圖片快取，且無法復原。"
          }
        }
      }
    },
    "Permanently deletes non-favorite clipboard records and image caches. Items in Favorites are kept." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht dauerhaft nicht favorisierte Zwischenablageeinträge und Bildcaches. Elemente in den Favoriten bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permanently deletes non-favorite clipboard records and image caches. Items in Favorites are kept."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime définitivement les éléments du presse-papiers non favoris et les caches d’images. Les éléments dans les favoris sont conservés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お気に入り以外のクリップボード履歴と画像キャッシュを完全に削除します。お気に入りの項目は保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "즐겨찾기가 아닌 클립보드 기록과 이미지 캐시를 영구적으로 삭제합니다. 즐겨찾기의 항목은 유지됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "永久删除非收藏的剪贴板记录和图片缓存，收藏中的内容会被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
