    "Image OCR Footer" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standardmäßig wird die geräteinterne Vision-OCR verwendet. Wenn aktiviert, wird zuerst die aktive multimodale KI-Konfiguration genutzt und bei Fehler oder fehlender Bildunterstützung auf Vision-OCR zurückgegriffen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defaults to on-device Vision OCR. When enabled, the active multimodal AI configuration is used first and falls back to Vision OCR if it fails or the model does not support images."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise par défaut l’OCR Vision local. Si l’option est activée, la configuration IA multimodale active est utilisée en priorité, avec un repli automatique sur l’OCR Vision en cas d’échec ou de modèle non compatible avec les images."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定では端末内の Vision OCR を使用します。オンにすると、有効化されているマルチモーダル AI 設定を優先的に呼び出し、失敗時や画像非対応モデルでは Vision OCR にフォールバックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기본값은 기기 내 Vision OCR입니다. 켜면 활성화된 멀티모달 AI 구성을 먼저 사용하고, 실패하거나 이미지 미지원 모델인 경우 Vision OCR로 자동 전환됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用本机 Vision OCR。开启后将优先调用激活的多模态 AI 配置；若调用失败或模型不支持图片，会自动回退到 Vision OCR。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設使用本機 Vision OCR。開啟後將優先呼叫已啟用的多模態 AI 設定；若失敗或模型不支援圖片，會自動回退至 Vision OCR。"
          }
        }
      }
    },
