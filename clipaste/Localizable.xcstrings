        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비활성화하면 항목을 두 번 클릭해도 클립보드에 복사만 되며 붙여넣기 단축키는 전송되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
