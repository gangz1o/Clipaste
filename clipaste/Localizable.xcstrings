        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像履歴項目の取得元アプリアイコンを押したまま画面上の任意の場所までドラッグし、放すと画像を固定できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이미지 기록 항목의 원본 앱 아이콘을 누른 채 화면의 원하는 위치로 드래그한 후 놓으면 이미지를 고정할 수 있습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
