    "When disabled, double-clicking an item only copies it to the clipboard without sending the paste shortcut." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgeschaltet kopiert ein Doppelklick den Inhalt nur in die Ablage, ohne den Einsetzen-Kurzbefehl zu senden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Désactivé, le double-clic copie simplement dans le presse-papiers sans envoyer le raccourci de collage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフにすると、ダブルクリックはクリップボードへのコピーのみを行い、ペーストショートカットは送信されません。"
